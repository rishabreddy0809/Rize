<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Rize</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Rize reads your calendar to include upcoming tests, deadlines, and events in your daily plan.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Rize reads your calendar to build smarter plans.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Rize uses your health data to personalize your daily plan based on your sleep, heart rate, and activity levels.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Rize reads your health data to generate better personalized daily plans.</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Required for CloudKit's push-driven sync (NSPersistentCloudKitContainer)
		     to import/export changes in the background rather than only on
		     foreground launch — without this, CloudKit logs "BUG IN CLIENT OF
		     CLOUDKIT: CloudKit push notifications require the 'remote-notification'
		     background mode" and silent-push-triggered sync never fires. -->
		<string>remote-notification</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Cinzel-Regular.ttf</string>
		<string>Cinzel-Bold.ttf</string>
		<string>Cinzel-ExtraBold.ttf</string>
		<string>Cinzel-Black.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
