<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Rize has no analytics, no ad SDK, and no server of its own — HealthKit,
	     Calendar, and profile data stay on-device or in the user's own private
	     CloudKit database. Nothing is collected for tracking or sent to a
	     third party, so both of these are empty/false rather than omitted. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage/UserDefaults.standard: XPManager's tier/defense state,
			     TodayView's low-energy-bonus flag — all app-own data, never used to
			     fingerprint the device. CA92.1 covers reading/writing data the app
			     itself wrote. WidgetSnapshotStore also reads/writes the App Group
			     suite to hand today's plan to the widget extension — 1C8F.1 covers
			     that same-App-Group access. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
